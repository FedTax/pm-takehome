# ---------------------------------------------------------------------------
# TaxRate demo app — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` to override the defaults. Every value here has
# a working default baked into the code, so the app runs with NO .env file at
# all. You only need this file if you want to change the demo credentials.
# ---------------------------------------------------------------------------

# Password for the web app login screen (see /login).
# Default if unset: "letmein"
DEMO_PASSWORD=letmein

# API key clients must send as `Authorization: Bearer <key>` to POST /api/rates.
# This is a PUBLIC demo key (it is intentionally shown in the docs and used by
# the landing-page playground), so it is safe to expose in the browser.
# Default if unset: "demo_sk_taxrate_public"
NEXT_PUBLIC_DEMO_API_KEY=demo_sk_taxrate_public
